type Env = { DB: D1Database; ALLOWED_ORIGIN: string };

type ContactPayload = { name?: unknown; email?: unknown; message?: unknown };

function json(data: unknown, status = 200, origin?: string) {
  return new Response(JSON.stringify(data), { status, headers: { 'content-type':'application/json; charset=utf-8', 'cache-control':'no-store', 'access-control-allow-origin': origin || 'null', 'access-control-allow-methods':'POST, OPTIONS', 'access-control-allow-headers':'content-type' } });
}

function isValidEmail(value: string): boolean {
  return /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(value) && value.length <= 254;
}

export default {
  async fetch(request: Request, env: Env): Promise<Response> {
    const origin = request.headers.get('Origin') || '';
    const allowed = origin === env.ALLOWED_ORIGIN || origin === '';
    if (!allowed) return json({ message: '허용되지 않은 요청입니다.' }, 403, env.ALLOWED_ORIGIN);
    if (request.method === 'OPTIONS') return json({}, 204, env.ALLOWED_ORIGIN);
    const url = new URL(request.url);
    if (url.pathname !== '/api/contact' || request.method !== 'POST') return json({ message:'Not Found' }, 404, env.ALLOWED_ORIGIN);
    if ((request.headers.get('content-type') || '').toLowerCase().split(';')[0] !== 'application/json') return json({ message:'JSON 요청만 허용됩니다.' }, 415, env.ALLOWED_ORIGIN);
    const contentLength = Number(request.headers.get('content-length') || '0');
    if (contentLength > 20_000) return json({ message:'요청 크기가 너무 큽니다.' }, 413, env.ALLOWED_ORIGIN);
    let body: ContactPayload;
    try { body = await request.json<ContactPayload>(); } catch { return json({ message:'잘못된 JSON 요청입니다.' }, 400, env.ALLOWED_ORIGIN); }
    const name = typeof body.name === 'string' ? body.name.trim() : '';
    const email = typeof body.email === 'string' ? body.email.trim() : '';
    const message = typeof body.message === 'string' ? body.message.trim() : '';
    if (!name || name.length > 80) return json({ message:'이름을 확인해 주세요.' }, 400, env.ALLOWED_ORIGIN);
    if (!isValidEmail(email)) return json({ message:'이메일 형식을 확인해 주세요.' }, 400, env.ALLOWED_ORIGIN);
    if (!message || message.length > 5000) return json({ message:'문의 내용을 확인해 주세요.' }, 400, env.ALLOWED_ORIGIN);
    const id = crypto.randomUUID();
    try {
      await env.DB.prepare('INSERT INTO contact_messages (id, name, email, message, status, created_at) VALUES (?, ?, ?, ?, ?, ?)')
        .bind(id, name, email, message, 'new', new Date().toISOString()).run();
      return json({ ok:true, message:'문의가 접수되었습니다.' }, 201, env.ALLOWED_ORIGIN);
    } catch {
      return json({ message:'문의 내용을 저장하지 못했습니다.' }, 500, env.ALLOWED_ORIGIN);
    }
  },
};
