'use client';

import { ChangeEvent, DragEvent, useMemo, useState } from 'react';
import {
  clampDimension,
  fileNameFor,
  loadImage,
  pixelsToUnit,
  transformImage,
  unitToPixels,
  type OutputFormat,
  type Unit,
} from '../lib/image';

const FORMAT_OPTIONS: Array<{ value: OutputFormat; label: string; note: string }> = [
  { value: 'image/jpeg', label: 'JPEG', note: '사진용, 용량이 작음' },
  { value: 'image/png', label: 'PNG', note: '투명 배경, 무손실' },
  { value: 'image/webp', label: 'WebP', note: '웹용, 지원 브라우저에서 효율적' },
];

const RATIO_OPTIONS = [
  { label: '원본', value: 'source' },
  { label: '1:1', value: '1:1' },
  { label: '3:4', value: '3:4' },
  { label: '4:3', value: '4:3' },
  { label: '9:16', value: '9:16' },
  { label: '16:9', value: '16:9' },
];

function ratioValue(value: string): number | null {
  if (value === 'source') return null;
  const [a,b] = value.split(':').map(Number);
  return a / b;
}

export function ImageConverter() {
  const [file, setFile] = useState<File | null>(null);
  const [image, setImage] = useState<HTMLImageElement | null>(null);
  const [width, setWidth] = useState(0);
  const [height, setHeight] = useState(0);
  const [unit, setUnit] = useState<Unit>('px');
  const [dpi, setDpi] = useState(96);
  const [ratio, setRatio] = useState('source');
  const [quality, setQuality] = useState(85);
  const [format, setFormat] = useState<OutputFormat>('image/jpeg');
  const [zoom, setZoom] = useState(100);
  const [dragging, setDragging] = useState(false);
  const [busy, setBusy] = useState(false);
  const [result, setResult] = useState<Blob | null>(null);
  const [resultUrl, setResultUrl] = useState<string | null>(null);
  const [status, setStatus] = useState('이미지를 선택하면 모든 처리가 이 브라우저 안에서 시작됩니다.');
  const [error, setError] = useState('');

  const sizeLabel = useMemo(() => {
    if (!result) return '';
    const kb = result.size / 1024;
    return kb < 1024 ? `${kb.toFixed(0)} KB` : `${(kb / 1024).toFixed(2)} MB`;
  }, [result]);

  async function acceptFile(nextFile: File) {
    setError(''); setStatus('이미지를 읽는 중입니다.'); setResult(null);
    if (nextFile.size > 50 * 1024 * 1024) {
      setError('최대 50MB까지 처리할 수 있습니다.'); setStatus(''); return;
    }
    try {
      const loaded = await loadImage(nextFile);
      setFile(nextFile); setImage(loaded);
      setWidth(loaded.naturalWidth); setHeight(loaded.naturalHeight);
      setUnit('px'); setDpi(96); setRatio('source');
      setStatus(`원본 ${loaded.naturalWidth.toLocaleString()} × ${loaded.naturalHeight.toLocaleString()}px`);
    } catch (e) {
      setError(e instanceof Error ? e.message : '이미지를 읽지 못했습니다.'); setStatus('');
    }
  }

  function onFileChange(event: ChangeEvent<HTMLInputElement>) {
    const nextFile = event.target.files?.[0];
    if (nextFile) void acceptFile(nextFile);
  }

  function onDrop(event: DragEvent<HTMLDivElement>) {
    event.preventDefault(); setDragging(false);
    const nextFile = event.dataTransfer.files?.[0];
    if (nextFile) void acceptFile(nextFile);
  }

  function updateWidth(nextValue: number) {
    const next = clampDimension(unitToPixels(nextValue, unit, dpi));
    setWidth(next);
    const r = ratioValue(ratio);
    if (r) setHeight(clampDimension(next / r));
  }

  function updateHeight(nextValue: number) {
    const next = clampDimension(unitToPixels(nextValue, unit, dpi));
    setHeight(next);
    const r = ratioValue(ratio);
    if (r) setWidth(clampDimension(next * r));
  }

  function handleRatio(next: string) {
    setRatio(next);
    if (!image) return;
    const r = ratioValue(next);
    if (!r) { setWidth(image.naturalWidth); setHeight(image.naturalHeight); return; }
    const currentW = width || image.naturalWidth;
    setHeight(clampDimension(currentW / r));
  }

  async function convert() {
    if (!image || !file) { setError('먼저 이미지를 선택해 주세요.'); return; }
    setBusy(true); setError(''); setStatus('브라우저에서 이미지를 변환하는 중입니다.');
    try {
      const blob = await transformImage(image, { width, height, quality, format, dpi }, ratio !== 'source');
      if (resultUrl) URL.revokeObjectURL(resultUrl);
      const url = URL.createObjectURL(blob);
      setResult(blob); setResultUrl(url);
      setStatus(`변환 완료 · ${width.toLocaleString()} × ${height.toLocaleString()}px · ${sizeLabel || '완료'}`);
    } catch (e) {
      setError(e instanceof Error ? e.message : '변환에 실패했습니다.'); setStatus('');
    } finally { setBusy(false); }
  }

  function download() {
    if (!result || !file) return;
    const a = document.createElement('a'); a.href = resultUrl || URL.createObjectURL(result); a.download = fileNameFor(file.name, format); a.click();
  }

  async function copyImage() {
    if (!result) return;
    try {
      if (!('ClipboardItem' in window) || !navigator.clipboard?.write) throw new Error('현재 브라우저에서는 이미지 복사를 지원하지 않습니다.');
      await navigator.clipboard.write([new ClipboardItem({ [result.type]: result })]);
      setStatus('이미지가 클립보드에 복사되었습니다.');
    } catch (e) { setError(e instanceof Error ? e.message : '이미지 복사에 실패했습니다.'); }
  }

  async function share() {
    if (!result || !file) return;
    try {
      if (!navigator.share) throw new Error('현재 브라우저에서 파일 공유 기능을 지원하지 않습니다.');
      const shareFile = new File([result], fileNameFor(file.name, format), { type: result.type });
      await navigator.share({ title: '변환된 이미지', files: [shareFile] });
    } catch (e) {
      if (e instanceof DOMException && e.name === 'AbortError') return;
      setError(e instanceof Error ? e.message : '공유에 실패했습니다.');
    }
  }

  function email() {
    if (!result || !file) return;
    const subject = encodeURIComponent('변환된 이미지');
    const body = encodeURIComponent(`변환된 이미지 파일명: ${fileNameFor(file.name, format)}\n\n첨부 파일은 메일 작성 화면에서 직접 추가해 주세요.`);
    window.location.href = `mailto:?subject=${subject}&body=${body}`;
  }

  return (
    <section id="converter" className="section-sm" aria-labelledby="converter-title">
      <div className="container">
        <div className="section-title">
          <h2 id="converter-title">사진을 올리고 원하는 규격으로 변환하세요</h2>
          <p>원본 이미지는 서버로 업로드하지 않습니다. 파일을 브라우저에서 읽고 변환 결과도 브라우저 메모리에서 생성합니다.</p>
        </div>

        <div className="converter-shell">
          <div className="converter-grid">
            <div>
              <div
                className={`dropzone${dragging ? ' dragging' : ''}`}
                onDragOver={(e) => { e.preventDefault(); setDragging(true); }}
                onDragLeave={() => setDragging(false)}
                onDrop={onDrop}
              >
                {!image ? (
                  <div>
                    <div className="icon-box" style={{ margin: '0 auto 14px' }} aria-hidden="true">
                      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" strokeWidth="2"><path d="M12 16V4m0 0-4 4m4-4 4 4"/><path d="M5 12v7a1 1 0 0 0 1 1h12a1 1 0 0 0 1-1v-7"/></svg>
                    </div>
                    <h2>이미지를 여기에 끌어놓기</h2>
                    <p>또는 파일을 선택하세요. 최대 50MB.</p>
                    <label className="btn btn-primary" htmlFor="image-file">이미지 선택</label>
                    <input id="image-file" className="file-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif" onChange={onFileChange} />
                  </div>
                ) : (
                  <div style={{ width:'100%' }}>
                    <div className="preview-area">
                      <div className="preview-head">
                        <strong>{file?.name}</strong>
                        <span>{image.naturalWidth.toLocaleString()} × {image.naturalHeight.toLocaleString()}px</span>
                      </div>
                      <div className="preview-canvas-wrap">
                        <img className="preview-image" src={resultUrl || image.src} alt="선택된 이미지 미리보기" style={{ width: `${zoom}%` }} />
                      </div>
                    </div>
                    <div className="hero-actions" style={{ marginTop:12 }}>
                      <label className="btn btn-secondary" htmlFor="replace-image">다른 이미지 선택</label>
                      <input id="replace-image" className="file-input" type="file" accept="image/jpeg,image/png,image/webp,image/gif" onChange={onFileChange} />
                    </div>
                  </div>
                )}
              </div>
              <div className={`status${error ? ' error' : status.includes('완료') || status.includes('복사') ? ' success' : ''}`} role="status" aria-live="polite">{error || status}</div>
            </div>

            <aside className="control-panel" aria-label="이미지 변환 설정">
              <div className="control-group">
                <h3>비율</h3>
                <div className="segmented">
                  {RATIO_OPTIONS.slice(0,3).map((opt) => <button key={opt.value} className={`seg-btn${ratio === opt.value ? ' active' : ''}`} onClick={() => handleRatio(opt.value)} type="button">{opt.label}</button>)}
                </div>
                <div className="segmented" style={{ marginTop:6 }}>
                  {RATIO_OPTIONS.slice(3).map((opt) => <button key={opt.value} className={`seg-btn${ratio === opt.value ? ' active' : ''}`} onClick={() => handleRatio(opt.value)} type="button">{opt.label}</button>)}
                </div>
              </div>

              <div className="control-group">
                <h3>크기 단위</h3>
                <div className="segmented">
                  {(['px','cm','mm'] as Unit[]).map((item) => <button key={item} className={`seg-btn${unit === item ? ' active' : ''}`} type="button" onClick={() => setUnit(item)}>{item}</button>)}
                </div>
                <div className="segmented" style={{ marginTop:6 }}>
                  <button className={`seg-btn${unit === 'in' ? ' active' : ''}`} type="button" onClick={() => setUnit('in')}>in</button>
                  <span /> <span />
                </div>
              </div>

              <div className="control-group">
                <h3>출력 크기</h3>
                <div className="control-row">
                  <div className="field"><label htmlFor="width">너비</label><input id="width" type="number" min="1" max="12000" value={Number(pixelsToUnit(width, unit, dpi).toFixed(2)) || ''} onChange={(e) => updateWidth(Number(e.target.value))} /></div>
                  <div className="field"><label htmlFor="height">높이</label><input id="height" type="number" min="1" max="12000" value={Number(pixelsToUnit(height, unit, dpi).toFixed(2)) || ''} onChange={(e) => updateHeight(Number(e.target.value))} /></div>
                </div>
              </div>

              <div className="control-group">
                <h3>품질 · 형식</h3>
                <div className="range-row">
                  <input aria-label="품질" type="range" min="10" max="100" step="1" value={quality} onChange={(e) => setQuality(Number(e.target.value))} />
                  <span className="range-value">{quality}%</span>
                </div>
                <div className="field" style={{ marginTop:12 }}><label htmlFor="format">파일 형식</label><select id="format" value={format} onChange={(e) => setFormat(e.target.value as OutputFormat)}>{FORMAT_OPTIONS.map((opt) => <option key={opt.value} value={opt.value}>{opt.label} — {opt.note}</option>)}</select></div>
              </div>

              <div className="control-group">
                <h3>DPI</h3>
                <div className="control-row">
                  <div className="field"><label htmlFor="dpi">해상도</label><input id="dpi" type="number" min="1" max="2400" value={dpi} onChange={(e) => setDpi(Math.min(2400, Math.max(1, Number(e.target.value) || 1)))} /></div>
                  <div className="field"><label>원본 크기 기준</label><input value={unit === 'px' ? 'px 직접 지정' : `${pixelsToUnit(width, unit, dpi).toFixed(2)} ${unit}`} readOnly /></div>
                </div>
              </div>

              <div className="control-group">
                <h3>미리보기 확대</h3>
                <div className="range-row">
                  <input aria-label="미리보기 확대" type="range" min="25" max="200" step="5" value={zoom} onChange={(e) => setZoom(Number(e.target.value))} />
                  <span className="range-value">{zoom}%</span>
                </div>
              </div>

              <button className="btn btn-primary" type="button" onClick={convert} disabled={!image || busy}>{busy ? '변환 중…' : '이미지 변환하기'}</button>
              {result && (
                <div className="action-grid">
                  <button className="btn btn-secondary" type="button" onClick={download}>다운로드</button>
                  <button className="btn btn-secondary" type="button" onClick={copyImage}>복사</button>
                  <button className="btn btn-secondary" type="button" onClick={share}>SNS/공유</button>
                  <button className="btn btn-secondary" type="button" onClick={email}>메일</button>
                </div>
              )}
              {result && <div className="notice">변환 파일: {sizeLabel}. 메일 버튼은 메일 작성 화면을 열고 파일을 자동 첨부하지 않습니다.</div>}
            </aside>
          </div>
        </div>
      </div>
    </section>
  );
}
